<Router AppAssembly="typeof(Program).Assembly" 
        AdditionalAssemblies="new[] { typeof(MeuApp.Shared.Pages.Home).Assembly }" 
        NotFoundPage="typeof(MeuApp.Shared.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MeuApp.Shared.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
